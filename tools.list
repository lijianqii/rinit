# rinit-tools install manifest.
#
# Columns are whitespace-separated:
#   applet  cargo-bin  install-path  busybox-link  max-kib  source
#
# `-` means "no BusyBox link" / "no per-tool size budget yet".
# The default profile is replace-system: the install path is a real ELF and the
# BusyBox link at the same path is removed. The `coexist` profile is for A/B and
# rollback and is not represented by this file.
#
# Existing binaries.
rinit      rinit      /sbin/rinit      -               1229  crates/rinit
rctl       rctl       /bin/rctl        -                600  crates/rctl
processes  processes  /bin/processes   -                600  crates/processes

# First replace-system set. These binaries are added in
# crates/rinit-tools/src/bin/ as the implementation lands.
mount      mount      /bin/mount       /bin/mount      1024  crates/rinit-tools/src/bin/mount.rs
umount     umount     /bin/umount      /bin/umount     1024  crates/rinit-tools/src/bin/umount.rs
hostname   hostname   /bin/hostname    /bin/hostname    600  crates/rinit-tools/src/bin/hostname.rs
reboot     reboot     /sbin/reboot     /sbin/reboot     600  crates/rinit-tools/src/bin/reboot.rs
poweroff   poweroff   /sbin/poweroff   /sbin/poweroff   600  crates/rinit-tools/src/bin/poweroff.rs
sysctl     sysctl     /sbin/sysctl     /sbin/sysctl     600  crates/rinit-tools/src/bin/sysctl.rs
ps         ps         /bin/ps          /bin/ps          800  crates/rinit-tools/src/bin/ps.rs
free       free       /usr/bin/free    /usr/bin/free    600  crates/rinit-tools/src/bin/free.rs
uptime     uptime     /usr/bin/uptime  /usr/bin/uptime  600  crates/rinit-tools/src/bin/uptime.rs
dmesg      dmesg      /bin/dmesg       /bin/dmesg       800  crates/rinit-tools/src/bin/dmesg.rs
df         df         /bin/df          /bin/df          800  crates/rinit-tools/src/bin/df.rs
top        top        /usr/bin/top     /usr/bin/top     800  crates/rinit-tools/src/bin/top.rs

# Second replace-system set: file operations that BusyBox used to provide.
ls         ls         /bin/ls          /bin/ls          800  crates/rinit-tools/src/bin/ls.rs
cat        cat        /bin/cat         /bin/cat         600  crates/rinit-tools/src/bin/cat.rs
cp         cp         /bin/cp          /bin/cp          800  crates/rinit-tools/src/bin/cp.rs
mv         mv         /bin/mv          /bin/mv          600  crates/rinit-tools/src/bin/mv.rs
rm         rm         /bin/rm          /bin/rm          600  crates/rinit-tools/src/bin/rm.rs
mkdir      mkdir      /bin/mkdir       /bin/mkdir       600  crates/rinit-tools/src/bin/mkdir.rs
ln         ln         /bin/ln          /bin/ln          600  crates/rinit-tools/src/bin/ln.rs
touch      touch      /bin/touch       /bin/touch       600  crates/rinit-tools/src/bin/touch.rs

# Third replace-system set: shell and script basics.
echo       echo       /bin/echo        /bin/echo        600  crates/rinit-tools/src/bin/echo.rs
sleep      sleep      /bin/sleep       /bin/sleep       600  crates/rinit-tools/src/bin/sleep.rs
uname      uname      /bin/uname       /bin/uname       600  crates/rinit-tools/src/bin/uname.rs
id         id         /usr/bin/id      /usr/bin/id      600  crates/rinit-tools/src/bin/id.rs
whoami     whoami     /usr/bin/whoami  /usr/bin/whoami  600  crates/rinit-tools/src/bin/whoami.rs
env        env        /usr/bin/env     /usr/bin/env     600  crates/rinit-tools/src/bin/env.rs
which      which      /usr/bin/which   /usr/bin/which   600  crates/rinit-tools/src/bin/which.rs
dirname    dirname    /usr/bin/dirname /usr/bin/dirname 600  crates/rinit-tools/src/bin/dirname.rs
basename   basename   /usr/bin/basename /usr/bin/basename 600 crates/rinit-tools/src/bin/basename.rs
realpath   realpath   /usr/bin/realpath /usr/bin/realpath 600 crates/rinit-tools/src/bin/realpath.rs
readlink   readlink   /usr/bin/readlink /usr/bin/readlink 600 crates/rinit-tools/src/bin/readlink.rs
mktemp     mktemp     /bin/mktemp      /bin/mktemp      600  crates/rinit-tools/src/bin/mktemp.rs
sync       sync       /bin/sync        /bin/sync        600  crates/rinit-tools/src/bin/sync.rs
stat       stat       /bin/stat        /bin/stat        800  crates/rinit-tools/src/bin/stat.rs

# Console login: independent replacements for BusyBox login/getty.
rlogin     rlogin     /bin/login       /bin/login       800  crates/rinit-tools/src/bin/rlogin/main.rs
rgetty     rgetty     /sbin/getty      /sbin/getty      800  crates/rinit-tools/src/bin/rgetty.rs
