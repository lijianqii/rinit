# `NeedsSocket=` acceptance unit, the consumer half (plan §7.8).
#
# It waits for `/run/sockd.sock` - bounded by `TimeoutStartSec` - and only then
# starts. Its output goes to the log ring, so `rctl log sockc.service` shows what
# it saw the filesystem holding at the moment it ran: `socket-present` is the
# assertion that the wait happened.
#
# The `test -S` is a step beyond what rinit checks (existence, not type) and is
# here because it can be: the provider creates a regular file in the guest, and
# saying "the path is there" is the whole of the contract.
#
# Started on demand, after `sockd.service`.
[Unit]
Description=socket consumer demo (started on demand)

[Service]
Type=oneshot
NeedsSocket=/run/sockd.sock
ExecStart=/bin/sh -c "test -f /run/sockd.sock && echo socket-present || echo socket-absent"
