# DHCP client for the development image's qemu NIC.
#
# This is a normal rinit service rather than an init script: `Type=simple`
# because `udhcpc -f` stays in the foreground for the life of the lease, and
# `Restart=on-failure` because a DHCP client that dies has to come back.
# `multi-user.target` pulls it in with `Wants=` so a board without a NIC does
# not fail the target.
#
# `ExecStart` is `udhcpc` itself, not a wrapper. `/etc/udhcpc/default.script`
# is the client's lease event handler (`-s`), not a startup script. The x86_64
# verification image has no eth0: `udhcpc` exits nonzero and the state machine
# leaves the unit failed; the target is unaffected because it only wants it.
[Unit]
Description=DHCP client on eth0
Requires=rinit-init.target
After=rinit-init.target

[Service]
Type=simple
ExecStart=/sbin/udhcpc -i eth0 -f -s /etc/udhcpc/default.script
Restart=on-failure
RestartSec=2
