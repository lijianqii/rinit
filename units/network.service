# Network manager.
#
# `rnetd` owns link/address/route/bridge state and the built-in DHCPv4 client.
# It is Type=notify: READY means the initial configuration was applied and the
# DHCP clients started. A missing NIC is not fatal; `network-online` is the
# unit that waits for an address, and it has its own timeout.
[Unit]
Description=Network manager
Requires=rinit-init.target
After=rinit-init.target

[Service]
Type=notify
ExecStart=/sbin/rnetd --config /etc/rnet/config
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_CHOWN
