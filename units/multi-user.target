# Default boot target (plan §7.2): the aggregation point everything else can
# order itself after.
#
# `Type=target` => no process is spawned for this unit; it becomes active as
# soon as its `Requires=` units are, and that in turn releases whatever waits
# on it. That is what decouples services from each other's internals.
#
# `Requires=` is a *strong* dependency: shell failing means this target fails
# too (plan §7.2). Unlike `After=`, which is ordering only, a missing or
# broken dependency here is visible rather than silently tolerated.
#
# Requires= accumulates across lines; splitting a long list keeps unit files
# readable.
#
# `getty.service` owns ttyAMA0, so it and `shell.service` are alternatives and
# must not both be required: two processes on one console both misbehave.
#
# getty is the default entry point - you type `root` at `login:` and press enter
# (the password field in /etc/passwd is empty, so there is nothing to type).
# Swap the two lines below to get a shell with no login step at all.
#
# Neither alternative is expressed as a `Conflicts=`, because M1 parses
# conflicts but does not stop units - that needs a live unit being stopped,
# which is M2's job.
[Unit]
Description=Multi-user system
Type=target
After=rinit-init.target

Requires=rinit-init.target
# Requires=shell.service
Requires=getty.service

# The M2 fault-injection service is `Wants=` (soft), not `Requires=`: it fails
# on purpose, and a unit designed to fail must not be able to fail the boot.
Wants=fault.service
