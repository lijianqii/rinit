# Serial console shell - the alternative to getty.service.
#
# NOT started by default: multi-user.target requires getty.service, which owns
# ttyAMA0. Both units want the same console and two processes on one tty both
# misbehave, so exactly one may be required.
#
# This one hands you a shell with no `login:` step at all: `login` is never
# involved, so there is no prompt to get past and no username to type. Switch to
# it by swapping the two Requires= lines in multi-user.target.
#
# `ExecStart=/bin/sh` with no arguments is deliberate. A banner would need
# something like `sh -c 'echo ...; exec /bin/sh'`, but rinit does not run a
# shell, and busybox `ash` rejects that quoting when the string is re-parsed
# from argv - the interpreter would exit immediately after the echo, leaving a
# dead prompt with nobody holding the console.
[Unit]
Description=Interactive serial console shell (no login)
Requires=rinit-init.target
After=rinit-init.target

[Service]
Type=simple
ExecStart=/bin/sh
