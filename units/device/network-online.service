# Wait for an address, not merely for the network manager to be exec'd.
#
# `network.service` is Type=notify, so it is Active once the initial config is
# applied; DHCP continues asynchronously. Services that need an address (NTP,
# SSH) order themselves after this one.
[Unit]
Description=Wait for a configured interface to come online
Requires=network.service
After=network.service

[Service]
Type=oneshot
ExecStart=/sbin/rncli wait-online --timeout 30
TimeoutStartSec=35
