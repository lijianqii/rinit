# `/dev` is devtmpfs, but a PTY also needs devpts mounted at /dev/pts.
# Without it Dropbear reports "PTY allocation request failed".
[Unit]
Description=Mount devpts for SSH PTYs
Requires=rinit-init.target
After=rinit-init.target
Before=sshd.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c "mkdir -p /dev/pts; /bin/grep -q ' /dev/pts ' /proc/mounts || /bin/mount -t devpts -o newinstance,ptmxmode=666,mode=620 devpts /dev/pts; /bin/ln -sf pts/ptmx /dev/ptmx"
